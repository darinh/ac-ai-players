<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HeadlessAcClient</RootNamespace>
    <AssemblyName>HeadlessAcClient</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\services-common\src\AcAiPlayers.ServicesClient\AcAiPlayers.ServicesClient.csproj" />
    <ProjectReference Include="..\..\..\world-nav\src\AcAiPlayers.WorldNav\AcAiPlayers.WorldNav.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeadlessAcClient.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.5.0" />
  </ItemGroup>

</Project>
