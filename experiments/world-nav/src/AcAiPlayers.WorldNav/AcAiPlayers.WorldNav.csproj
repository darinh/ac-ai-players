<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AcAiPlayers.WorldNav</RootNamespace>
    <AssemblyName>AcAiPlayers.WorldNav</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- log4net is initialised via app config in consumers; suppress the
         missing-config-file warning that ACE.DatLoader's log4net usage
         would otherwise produce in pure-library consumers.
         NU1902 = transitive log4net 2.0.17 has a known moderate-severity
         CVE; ACE-bots pins it deliberately; not something we can fix
         here. -->
    <NoWarn>$(NoWarn);CS1591;NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AcAiPlayers.WorldNav.Tests" />
    <InternalsVisibleTo Include="WorldNavBuilder" />
  </ItemGroup>

  <!--
    Cross-repo project references to the ACE-bots fork's DatLoader.
    The DAT file format is implemented there and we re-use it verbatim
    rather than copying ~3000 lines of file-format code.

    Per ADR-0010, the long-term home for navigation code is
    `ACE.Mod.Pathfinding` (a Harmony mod that loads inside ACE.Server
    and can therefore project-reference DatLoader directly). This
    library is the early shared implementation that BOTH the future
    mod and the headless client can consume.

    Assumes ACE-bots is cloned as a sibling repo. The relative depth to
    the sibling differs between a normal checkout (repo root is one
    level under the repos dir -> 5 `..`) and a linked worktree under
    `.worktrees/<id>/` (-> 7 `..`). We probe both with Exists() against
    $(MSBuildThisFileDirectory) so the project builds from either
    location. Override $(AceBotsRoot) to point elsewhere.
  -->
  <PropertyGroup>
    <_AceBots5>$(MSBuildThisFileDirectory)..\..\..\..\..\ACE-bots</_AceBots5>
    <_AceBots7>$(MSBuildThisFileDirectory)..\..\..\..\..\..\..\ACE-bots</_AceBots7>
    <AceBotsRoot Condition="'$(AceBotsRoot)' == '' And Exists('$(_AceBots5)\Source\ACE.Common\ACE.Common.csproj')">$(_AceBots5)</AceBotsRoot>
    <AceBotsRoot Condition="'$(AceBotsRoot)' == '' And Exists('$(_AceBots7)\Source\ACE.Common\ACE.Common.csproj')">$(_AceBots7)</AceBotsRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AceBotsRoot)\Source\ACE.DatLoader\ACE.DatLoader.csproj" />
    <ProjectReference Include="$(AceBotsRoot)\Source\ACE.Entity\ACE.Entity.csproj" />
    <ProjectReference Include="$(AceBotsRoot)\Source\ACE.Common\ACE.Common.csproj" />
  </ItemGroup>

</Project>
